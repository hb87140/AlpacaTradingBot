# ── Alpaca API credentials ─────────────────────────────────────────────────
# Get these from https://app.alpaca.markets → API Keys
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# "true" = paper trading (safe, no real money)
# "false" = live trading (real money — only when ready)
ALPACA_PAPER=true

# Data feed: "iex" (free, ~95% coverage) or "sip" (paid, full consolidated tape)
ALPACA_DATA_FEED=iex

# ── Optional overrides ─────────────────────────────────────────────────────
# Dashboard port — cloud platforms set this automatically; leave blank locally
# PORT=8080

# Backtest initial capital (only affects run_backtest.py)
# VELOCITY_BACKTEST_INITIAL_CAPITAL=2000.0

# Scanner pool sizes (default 50 each)
# ALPACA_SCANNER_TOP=50
# ALPACA_SCANNER_TOP_GAINERS=50

# Position sizing floor
# VELOCITY_MIN_BUCKET_SIZE=500.0
# VELOCITY_MAX_POSITIONS_CAP=8
